[Unit]
Description=CodeAttest SLO check for %i
After=codeattest-%i.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/codeattest/%i-observability.env
ExecStart=/usr/bin/node /usr/local/lib/codeattest/check-observability.mjs --url http://127.0.0.1:${CODEATTEST_HOST_PORT}/readyz --journal-unit codeattest-%i.service
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
