[Unit]
Description=CodeAttest demo host
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=codeattest-demo
Group=codeattest-demo
WorkingDirectory=/opt/codeattest/demo/current
Environment=CREDENTIALS_DIRECTORY=%d
LoadCredential=demo-totp-key:/etc/codeattest/demo/totp-key
LoadCredentialEncrypted=demo-signing-key:/etc/codeattest/demo/signing-key.cred
ExecStart=/usr/bin/node /opt/codeattest/demo/current/services/host/dist/services/host/src/main.js /etc/codeattest/demo-host.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codeattest/demo

[Install]
WantedBy=multi-user.target
