[Unit]
Description=CodeAttest %i transparency checkpoint publication
After=network-online.target postgresql.service codeattest-%i.service
Wants=network-online.target

[Service]
Type=oneshot
User=codeattest-%i
Group=codeattest-%i
WorkingDirectory=/opt/codeattest/%i/current
Environment=CREDENTIALS_DIRECTORY=%d
# The bearer token for the off-box anchor (Section 2 §7). The host config's
# transparency_anchor.token_credential must be "%i-anchor-token". Until the
# anchor is provisioned this unit fails, which is the intended fail-closed state.
LoadCredential=%i-anchor-token:/etc/codeattest/%i/anchor-token
ExecStart=/usr/bin/node /opt/codeattest/%i/current/services/host/dist/services/host/src/worker/main.js checkpoint /etc/codeattest/%i-host.json
TimeoutStartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codeattest/%i
