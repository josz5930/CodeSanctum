[Unit]
Description=CodeAttest %i worker (scanner-finding normalization)
After=network-online.target postgresql.service codeattest-%i.service
Wants=network-online.target

[Service]
Type=simple
User=codeattest-%i
Group=codeattest-%i
WorkingDirectory=/opt/codeattest/%i/current
Environment=CREDENTIALS_DIRECTORY=%d
# The object-store envelope key; the host config's object_store_envelope_key_ref
# must be "%i-envelope-key".
LoadCredential=%i-envelope-key:/etc/codeattest/%i/envelope-key
ExecStart=/usr/bin/node /opt/codeattest/%i/current/services/host/dist/services/host/src/worker/main.js run /etc/codeattest/%i-host.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/codeattest/%i

[Install]
WantedBy=multi-user.target
